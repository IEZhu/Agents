# Optional: set both keys to enable Langfuse tracing. Keep comments on their own
# line: older python-dotenv reads "KEY=  # text" as the value "# text".
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
ANTHROPIC_API_KEY=sk-ant-...  # Optional: for document OCR
AGENTS_DEBUG=0                # Set to 1 for JSON debug logs (stdio: the client project's logs/; shared daemon: its private debug/)

# Embedding model — setup writes it when unset: scripts/init_repo.sh/.bat
# prompt for it; init_repo.sh --yes (used by install.sh) picks it from installed
# RAM. If it stays unset, the code default shown below applies.
# Options: intfloat/multilingual-e5-large (1.1GB), sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (120MB), sentence-transformers/all-MiniLM-L6-v2 (22MB)
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Optional: override fastembed model cache directory (default: ~/.cache/fastembed)
# Must be persistent — avoid /tmp on macOS (launchd auto-cleans it).
# The shared daemon's `python -m src.daemon install` reads it only from the shell
# environment, not from .env; the service keeps the path recorded at install.
# FASTEMBED_CACHE_DIR=

# --- Client configuration paths ---------------------------------------------
# Export these in the shell running the installers (install.sh,
# scripts/init_repo.sh/.bat), scripts/install_instructions.py or daemon
# migrate/audit. These tools read the process environment, so setting them in
# .env has no effect. They select client files, not the daemon state directory.
# Use absolute paths. For migrate/audit, an explicit --client-config CLIENT=PATH
# overrides the corresponding environment setting, and --workspace retains
# project Codex/Cursor paths unless explicitly overridden.
# CLAUDE_CONFIG_DIR=/absolute/claude-profile
# CODEX_HOME=/absolute/existing-codex-home
# These Agents-Core settings identify exact files already used by the clients;
# they do not change Cursor or Claude Desktop's own configuration discovery.
# AGENTS_CURSOR_MCP_CONFIG=/absolute/cursor-profile/mcp.json
# AGENTS_CLAUDE_DESKTOP_CONFIG=/absolute/desktop-profile/claude_desktop_config.json

# Seconds a retrieval tool waits for background startup (stores, embedding model,
# rules) before it answers status `warming_up`; the handshake never waits.
WARMUP_WAIT_SECONDS=20

# --- Background auto-update --------------------------------------------------
# Two-phase staged update (the default): a background thread (non-blocking)
# fetches and builds the new version's vector stores in an isolated git worktree
# under data/.prepared/<sha>, never touching the live install; the next IDLE start
# activates it with a fast local ff-merge + atomic file move. It acts ONLY when
# the checked-out branch is AGENTS_AUTO_UPDATE_BRANCH and the tree is clean
# (fast-forward only) — a no-op on feature branches, so local development is
# never disturbed. These settings drive the standalone stdio updater, which the
# shared macOS daemon disables. The daemon controller (`src.daemon update`,
# `auto-update`) reads AGENTS_AUTO_UPDATE_REMOTE, _BRANCH, _TIMEOUT and
# _REINDEX_TIMEOUT only from its own process environment, never from .env; its
# updater LaunchAgent does not set them, so scheduled runs normally use the
# defaults below (docs/shared-mcp-daemon.md).
AGENTS_AUTO_UPDATE=1                     # 0 disables auto-update
AGENTS_AUTO_UPDATE_REMOTE=origin         # git remote to track
AGENTS_AUTO_UPDATE_BRANCH=main           # only update when this branch is checked out
AGENTS_AUTO_UPDATE_TIMEOUT=30            # seconds per git op (fetch/merge/...)
AGENTS_AUTO_UPDATE_INTERVAL=900          # throttle: skip fetch if checked within N s (0 = always)
AGENTS_AUTO_UPDATE_REINDEX_TIMEOUT=600   # seconds per updater index build (staged, in-place, daemon update)
AGENTS_AUTO_UPDATE_STAGING=1             # 0 = synchronous in-place update at an idle start
# AGENTS_AUTO_UPDATE_STAGING_DIR=        # staging worktrees parent (default: data/.prepared;
                                         # must share a filesystem with data/ for atomic moves)
# --- Intent classifier (src/engine/intent.py) --------------------------------
# Replaces the `infer_tier` length+regex heuristic with a two-axis TaskProfile:
# `mode` (the reasoning method the task needs) and `tier` (the enrichment budget).
# Measured on evals/datasets/routing.jsonl (110 labeled samples):
#   legacy      67/110 = 60.9%, deep-tier share 39.1%
#   classifier  77/110 = 70.0%, deep-tier share 26.4%
# The accuracy gain is directional but NOT statistically significant (paired
# exact McNemar p=0.17 full set, p=0.80 on the held-out half). The deep-share
# reduction is deterministic; end to end, mirroring the server's promotion, it
# shrinks the injected prompt by 8.4% (deep 43 -> 29 on the golden set).
# Reproduce with: python -m evals.runners.run_tier --compare
INTENT_CLASSIFIER_ENABLED=0              # 1 enables the classifier (default: legacy rule)
INTENT_DEEP_AT=5                         # structural points that promote a mode's tier one step
INTENT_LONG_CHARS=150                    # +1 point above this length
INTENT_VERY_LONG_CHARS=500               # +2 points above this length (length alone never reaches deep)
INTENT_CONVERSE_MAX_CHARS=60             # a greeting only means "converse" below this length

# --- Bench (optional) --------------------------------------------------------
# scripts/eval.sh bench and scripts/bench_*.sh source .env. --provider openai
# (the default) needs OPENAI_API_KEY; anthropic uses ANTHROPIC_API_KEY above.
# *_BASE_URL routes a provider through a proxy or gateway. JUDGE_PROVIDER and
# JUDGE_MODEL select the judge; --provider local ignores them and is configured
# as in evals/LOCAL_MODELS.md.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# ANTHROPIC_BASE_URL=
# JUDGE_PROVIDER=anthropic
# JUDGE_MODEL=claude-sonnet-4-6
